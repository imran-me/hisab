# =============================================================================
# Hisab · environment
#
# Copy to .env and fill in. NEVER COMMIT .env - it is in .gitignore, and the
# database password and APP_KEY are the two things in this project that are
# genuinely secret.
#
# On Hostinger this file lives at
#   /home/u239665931/domains/gulfrabit.com/hisab-app/.env
# which is ABOVE the web root, so it is unreachable over HTTP even if .htaccess
# were deleted. That is the whole reason the framework does not sit in
# public_html - see docs/DEPLOY-HOSTINGER.md §8.
#
# The values below are the PRODUCTION shape. Local development overrides
# APP_ENV, APP_DEBUG and the DB_* block; everything else is the same.
# =============================================================================

APP_NAME=Hisab
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hisab.gulfrabit.com

# APP_DEBUG=true PRINTS THE STACK TRACE, THE FILE PATHS AND THE .env VALUES
# INTO THE HTTP RESPONSE. On an app holding a ledger and an encrypted vault that
# is not a debugging convenience, it is a disclosure. It stays false here and is
# turned on only in a local .env.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# THERE IS DELIBERATELY NO APP_TIMEZONE HERE. Laravel 13's config/app.php pins
# the timezone to UTC and does not read one from the environment, and that is
# the behaviour this app wants: shared/backend/api-contract.md specifies
# created_at and updated_at as ISO 8601 UTC instants. The dates a person cares
# about are different - occurred_on is a LOCAL date, "what day did I spend
# this" - and it arrives from the browser as YYYY-MM-DD already resolved in the
# owner's own timezone. So the server never converts it and never needs to know
# where the owner is. Setting a server timezone here would silently shift every
# machine timestamp instead.

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# `error` and not `debug`: shared hosting has a disk quota, and a debug-level
# log on a request-per-second app fills it and then the app stops writing
# anything at all. Also, less in the log is less to leak.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u239665931_hisab
DB_USERNAME=u239665931_hisab
DB_PASSWORD=

# Kept deliberately separate from u239665931_eon, which holds the ERP: different
# backup schedule, different blast radius, and this one will hold the vault.

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# SESSION_LIFETIME is 30 days: this is a single-owner app used from a phone, and
# being logged out of your own ledger every two hours is the kind of friction
# that stops entries being recorded at all. SESSION_SECURE_COOKIE=true is safe
# because the site is https-only and .htaccess enforces it - on plain http it
# would silently prevent login instead, which is a confusing way to find out.

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# database rather than redis for all three: shared hosting has MySQL and does
# not have Redis, and a config naming a service that is not there fails at the
# first cache write rather than at boot.

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hisab@gulfrabit.com"
MAIL_FROM_NAME="${APP_NAME}"

# There is no email in this product yet. `log` rather than smtp so that anything
# which tries to send goes to the log instead of failing a request - and so that
# no credentials sit here for a feature that does not exist.
